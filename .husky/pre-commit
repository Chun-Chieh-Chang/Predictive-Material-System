#!/bin/sh

# ─────────────────────────────────────────────────────
# Pre-commit Hook — 料事如神系統 (PMS)
# 在 commit 前全自動執行：
# 0. 全自動自進化體系閉環 (Auto-Evolution Gate: KB 索引/MECE/防禦升級)
# 1. UI 變更前置檢查
# 2. TypeScript 類型檢查
# 3. 對比度與按鈕白字防禦檢查
# ─────────────────────────────────────────────────────

echo "🧬 PMS Pre-commit & Auto-Evolution Checks..."

# 0. 自動同步最新版號至 src/utils/version.ts 並納入暫存
node .impeccable/scripts/sync-version.mjs
git add src/utils/version.ts

# 0.1. 全自動自我進化閉環門禁 (Auto-Evolution Gate)
node .impeccable/scripts/auto-evolution-gate.mjs || {
  echo "❌ 自我進化閉環檢查失敗"
  exit 1
}

# 1. UI 變更 → 驗證標準前置檢查（PA-01）
echo "  → UI 驗證標準檢查..."
node .impeccable/scripts/pre-task-checklist.mjs || {
  echo "❌ UI 驗證標準檢查失敗，請先定義驗證標準再提交"
  exit 1
}
echo "  ✅ UI 驗證標準檢查通過"

# 2. TypeScript 檢查
echo "  → TypeScript check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript 檢查失敗，請修復後重新提交"
  exit 1
fi
echo "  ✅ TypeScript 檢查通過"

echo "✅ 所有自動化自進化與品質檢查通過，準備提交"

