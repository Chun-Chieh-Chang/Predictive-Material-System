#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# ─────────────────────────────────────────────────────
# Pre-commit Hook — 料事如神系統 (PMS)
# 在 commit 前執行以下檢查：
# 1. TypeScript 類型檢查
# 2. MECE 完整性校驗（對新增/修改的 CAPA 報告）
# 3. 對比度校驗
# ─────────────────────────────────────────────────────

echo "🔍 PMS Pre-commit Checks..."

# 0. UI 變更 → 驗證標準前置檢查（PA-01）
echo "  → UI 驗證標準檢查..."
node .impeccable/scripts/pre-task-checklist.mjs || {
  echo "❌ UI 驗證標準檢查失敗，請先定義驗證標準再提交"
  exit 1
}
echo "  ✅ UI 驗證標準檢查通過"

# 1. TypeScript 檢查
echo "  → TypeScript check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript 檢查失敗，請修復後重新提交"
  exit 1
fi
echo "  ✅ TypeScript 檢查通過"

# 2. MECE 完整性校驗（僅檢查本次提交新增/修改的 CAPA 報告）
echo "  → MECE 完整性校驗..."
git diff --cached --name-only | grep -E 'docs/CAPA-.*\.md' | while read capadoc; do
  echo "    校驗: $capadoc"
  node .impeccable/scripts/mec-validator.mjs "$capadoc" || {
    echo "❌ MECE 校驗失敗: $capadoc"
    echo "   請使用 .impeccable/mec-pre-injection-prompt.md 中的模板重新生成"
    exit 1
  }
done
echo "  ✅ MECE 校驗通過"

# 3. 對比度校驗
echo "  → 對比度校驗..."
node .impeccable/scripts/contrast-check.mjs src/components/ 2>/dev/null || true
echo "  ✅ 對比度校驗完成"

echo "✅ 所有檢查通過，準備提交"
